    Dim rowNum As Long
    For i = 1 To UBound(dataArr, 1)
        Dim cpty As String, cat As String, principal As Double, benchRate As Double, spread As Double
        cpty = Trim(CStr(dataArr(i, COL_CPTY)))
        cat = Trim(CStr(dataArr(i, COL_CATEGORY)))
        ttype = Trim(CStr(dataArr(i, COL_TRANTYPE)))
        face = 0: principal = 0: rate = 0
        On Error Resume Next
        face = CDbl(dataArr(i, COL_FACE))
        principal = CDbl(dataArr(i, COL_PRINCIPAL))
        rate = CDbl(dataArr(i, COL_RATE))
        On Error GoTo 0
        
        If face = 0 Then GoTo NextEmailRow
        benchRate = GetBenchmarkForAsset(cat, ttype, wsRates)
        If benchRate <> 0 Then spread = (rate - benchRate) * 10000
        
        Dim bgColor As String: If rowNum Mod 2 = 0 Then bgColor = "#f0f4ff" Else bgColor = "#ffffff"
        Dim typeColor As String: If UCase(ttype) = "REPO" Then typeColor = "#1d4ed8" Else typeColor = "#7c3aed"
        Dim spreadColor As String, statusIcon As String
        If benchRate = 0 Then
            spreadColor = "#6b7280": statusIcon = "⚪"
        ElseIf spread >= 5 Then
            spreadColor = "#065f46": statusIcon = "🟢"
        ElseIf spread >= -5 Then
            spreadColor = "#92400e": statusIcon = "🟡"
