Option Explicit

' ---- GLOBAL CONSTANTS ----
Public Const SRC_SHEET As String = "Trade Data"
Public Const DASH_SHEET As String = "Dashboard"
Public Const RATES_SHEET As String = "Benchmark Rates"
Public Const CONTROL_SHEET As String = "Control Panel"
Public Const DRILLDOWN_SHEET As String = "Trade Drill-Down"

Public Const COL_CPTY As Integer = 1
Public Const COL_CATEGORY As Integer = 2
Public Const COL_TRANTYPE As Integer = 3
Public Const COL_FACE As Integer = 4
Public Const COL_PRINCIPAL As Integer = 5
Public Const COL_RATE As Integer = 6

' ---------------------------------------------------------------
' MASTER SETUP
' ---------------------------------------------------------------
Sub RunFullSetup()
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.DisplayAlerts = False ' Mute deletion warnings
    
    Call BuildRatesSheet
    Call BuildDashboard       ' Must build Dashboard before Control Panel for KPI formulas
    Call BuildControlPanel
    Call BuildDrillDown
    Call RefreshDashboard
    
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    
    MsgBox "Dashboard built successfully!" & vbNewLine & "Go to 'Control Panel' to start filtering.", vbInformation, "Setup Complete"
End Sub

' ---------------------------------------------------------------
' BENCHMARK RATES
' ---------------------------------------------------------------
Sub BuildRatesSheet()
    Dim ws As Worksheet
    On Error Resume Next
    ThisWorkbook.Sheets(RATES_SHEET).Delete
    On Error GoTo 0
    Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    ws.Name = RATES_SHEET
    
    With ws.Range("A1:F1")
        .Value = Array("Rate Name", "Ticker (Bloomberg)", "Rate (%)", "Source", "Last Updated", "Notes")
        .Font.Bold = True
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(0, 51, 102)
        .HorizontalAlignment = xlCenter
    End With
    
    Dim rates As Variant
    rates = Array( _
        Array("SOFR", "SOFR Index", 5.30, "Bloomberg", "Manual", "Secured Overnight Financing Rate"), _
        Array("SOFR+3", "SOFR Index", 5.33, "Bloomberg", "Manual", "SOFR + 3bps"), _
        Array("SOFR+4", "SOFR Index", 5.34, "Bloomberg", "Manual", "SOFR + 4bps"), _
        Array("SOFR+10", "SOFR Index", 5.40, "Bloomberg", "Manual", "SOFR + 10bps"), _
        Array("Fed Funds", "FEDL01 Index", 5.33, "Bloomberg", "Manual", "Effective Fed Funds Rate"), _
        Array("SONIA", "SONIO/N Index", 5.20, "Bloomberg", "Manual", "Sterling Overnight Index Average"), _
        Array("UST GC Rate", "USGG10YR Index", 4.50, "Bloomberg", "Manual", "UST General Collateral Financing Rate"), _
        Array("CME UST Repo", "CMEUST Index", 5.31, "Bloomberg", "Manual", "CME UST Repo Reference Rate"), _
        Array("CME Gilt Repo", "CMEGILT Index", 5.15, "Bloomberg", "Manual", "CME Gilt Repo Reference Rate") _
    )
    
    Dim i As Integer
    For i = 0 To UBound(rates)
        ws.Cells(i + 2, 1).Value = rates(i)(0)
        ws.Cells(i + 2, 2).Value = rates(i)(1)
        ws.Cells(i + 2, 3).Value = rates(i)(2) / 100
        ws.Cells(i + 2, 3).NumberFormat = "0.000%"
        ws.Cells(i + 2, 4).Value = rates(i)(3)
        ws.Cells(i + 2, 5).Value = rates(i)(4)
        ws.Cells(i + 2, 6).Value = rates(i)(5)
    Next i
    
    ws.Range("A12").Value = "--- BLOOMBERG UPGRADE ---"
    ws.Range("A12").Font.Bold = True
    ws.Range("A12").Font.Color = RGB(180, 0, 0)
    ws.Range("A13").Value = "When Bloomberg is active, replace Column C values with:"
    ws.Range("A14").Value = "=BDP(""SOFR Index"",""PX_LAST"")/100"
    
    ws.Columns("A:F").AutoFit
    ws.Tab.Color = RGB(0, 112, 192)
    
    On Error Resume Next
    ThisWorkbook.Names("BenchmarkRates").Delete
    On Error GoTo 0
    ThisWorkbook.Names.Add Name:="BenchmarkRates", RefersTo:=ws.Range("A2:C10")
End Sub

