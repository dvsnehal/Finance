' DRILL-DOWN SHEET
' ---------------------------------------------------------------
Sub BuildDrillDown()
    Dim wsSrc As Worksheet, wsDrill As Worksheet, wsRates As Worksheet
    Dim lastRow As Long, i As Long
    
    If Not SheetExists(SRC_SHEET) Then Exit Sub
    Set wsSrc = ThisWorkbook.Sheets(SRC_SHEET)
    Set wsRates = ThisWorkbook.Sheets(RATES_SHEET)
    
    On Error Resume Next
    ThisWorkbook.Sheets(DRILLDOWN_SHEET).Delete
    On Error GoTo 0
    Set wsDrill = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(DASH_SHEET))
    wsDrill.Name = DRILLDOWN_SHEET
    
    wsDrill.Cells.Interior.Color = RGB(15, 23, 42)
    wsDrill.Cells.Font.Color = RGB(226, 232, 240)
    
    With wsDrill.Range("A1:K1")
        .Merge
        .Value = "TRADE DRILL-DOWN"
        .Font.Size = 14
        .Font.Bold = True
        .Font.Color = RGB(52, 211, 153)
        .HorizontalAlignment = xlCenter
    End With
    
    Dim headers As Variant
    headers = Array("Counterparty", "Category", "Tran Type", "Face", "Principal", "Rate (%)", "Benchmark (%)", "Spread (bps)", "P&L Est ($)", "Status", "Row #")
    
    Dim h As Integer
    For h = 0 To UBound(headers)
        With wsDrill.Cells(4, h + 1)
            .Value = headers(h)
            .Font.Bold = True
            .Font.Color = RGB(255, 255, 255)
            .Interior.Color = RGB(0, 51, 102)
            .HorizontalAlignment = xlCenter
        End With
    Next h
    
    lastRow = wsSrc.Cells(wsSrc.Rows.Count, 1).End(xlUp).Row
    If lastRow < 2 Then Exit Sub
    
    Dim dataArr As Variant
    dataArr = wsSrc.Range(wsSrc.Cells(2, 1), wsSrc.Cells(lastRow, COL_RATE)).Value
    Dim writeRow As Integer: writeRow = 5
    
    For i = 1 To UBound(dataArr, 1)
        Dim cpty As String, cat As String, ttype As String
        Dim face As Double, principal As Double, rate As Double
        cpty = Trim(CStr(dataArr(i, COL_CPTY)))
        cat = Trim(CStr(dataArr(i, COL_CATEGORY)))
        ttype = Trim(CStr(dataArr(i, COL_TRANTYPE)))
        face = 0: principal = 0: rate = 0
        
        On Error Resume Next
        face = CDbl(dataArr(i, COL_FACE))
        principal = CDbl(dataArr(i, COL_PRINCIPAL))
        rate = CDbl(dataArr(i, COL_RATE))
        On Error GoTo 0
        
        If face = 0 Then GoTo NextRow
        
        Dim benchRate As Double, spread As Double, pnl As Double
        benchRate = GetBenchmarkForAsset(cat, ttype, wsRates)
        If benchRate <> 0 Then
            spread = (rate - benchRate) * 10000
            pnl = face * (rate - benchRate) / 360
        End If
        
        Dim rowColor As Long, upperType As String
        upperType = UCase(ttype)
        If upperType = "REPO" Then
            rowColor = RGB(20, 37, 80)
        ElseIf upperType = "RR" Or InStr(upperType, "REVERSE") > 0 Then
            rowColor = RGB(50, 20, 60)
        ElseIf i Mod 2 = 0 Then
            rowColor = RGB(22, 33, 62)
        Else
            rowColor = RGB(15, 23, 42)
        End If
        
        wsDrill.Rows(writeRow).Interior.Color = rowColor
        wsDrill.Cells(writeRow, 1).Value = cpty
        wsDrill.Cells(writeRow, 2).Value = cat
        wsDrill.Cells(writeRow, 3).Value = ttype
        If upperType = "REPO" Then wsDrill.Cells(writeRow, 3).Font.Color = RGB(96, 165, 250) Else wsDrill.Cells(writeRow, 3).Font.Color = RGB(196, 181, 253)
        
        wsDrill.Cells(writeRow, 4).Value = face
        wsDrill.Cells(writeRow, 5).Value = principal
        wsDrill.Range(wsDrill.Cells(writeRow, 4), wsDrill.Cells(writeRow, 5)).NumberFormat = "#,##0"
        
        wsDrill.Cells(writeRow, 6).Value = rate
        wsDrill.Cells(writeRow, 7).Value = benchRate
        wsDrill.Range(wsDrill.Cells(writeRow, 6), wsDrill.Cells(writeRow, 7)).NumberFormat = "0.000%"
        
        wsDrill.Cells(writeRow, 8).Value = spread
        wsDrill.Cells(writeRow, 8).NumberFormat = "+0.0;-0.0;0.0"
        If spread > 0 Then wsDrill.Cells(writeRow, 8).Font.Color = RGB(52, 211, 153) Else If spread < 0 Then wsDrill.Cells(writeRow, 8).Font.Color = RGB(248, 113, 113)
        
        wsDrill.Cells(writeRow, 9).Value = pnl
        wsDrill.Cells(writeRow, 9).NumberFormat = "$#,##0;($#,##0)"
        If pnl > 0 Then wsDrill.Cells(writeRow, 9).Font.Color = RGB(52, 211, 153) Else wsDrill.Cells(writeRow, 9).Font.Color = RGB(248, 113, 113)
        
        Dim status As String
        If benchRate = 0 Then
            status = "⚪ N/A"
        ElseIf spread >= 5 Then
            status = "🟢 Favourable"
        ElseIf spread >= -5 Then
            status = "🟡 At Market"
        Else
            status = "🔴 Unfavourable"
        End If
        wsDrill.Cells(writeRow, 10).Value = status
        wsDrill.Cells(writeRow, 11).Value = i + 1
        writeRow = writeRow + 1
NextRow:
    Next i
    
    Dim totalRow As Integer: totalRow = writeRow
    wsDrill.Rows(totalRow).Interior.Color = RGB(0, 51, 102)
    wsDrill.Rows(totalRow).Font.Bold = True
    wsDrill.Rows(totalRow).Font.Color = RGB(255, 255, 255)
    
    wsDrill.Cells(totalRow, 1).Value = "TOTALS"
    wsDrill.Cells(totalRow, 4).Formula = "=SUM(D5:D" & totalRow - 1 & ")"
    wsDrill.Cells(totalRow, 5).Formula = "=SUM(E5:E" & totalRow - 1 & ")"
    wsDrill.Range(wsDrill.Cells(totalRow, 4), wsDrill.Cells(totalRow, 5)).NumberFormat = "#,##0"
    wsDrill.Cells(totalRow, 9).Formula = "=SUM(I5:I" & totalRow - 1 & ")"
    wsDrill.Cells(totalRow, 9).NumberFormat = "$#,##0;($#,##0)"
    
    ' Standard Windows AutoFilter application
    wsDrill.AutoFilterMode = False
    wsDrill.Range("A4:K" & totalRow).AutoFilter
    
    wsDrill.Activate
    wsDrill.Range("A5").Select
    ActiveWindow.FreezePanes = True
    wsDrill.Columns("A:K").AutoFit
    wsDrill.Tab.Color = RGB(52, 211, 153)
    
    ThisWorkbook.Sheets(CONTROL_SHEET).Activate
End Sub

