            spreadColor = "#991b1b": statusIcon = "🔴"
        End If
        
        html = html & "<tr style='background:" & bgColor & ";'><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;'><b>" & cpty & "</b></td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;'>" & cat & "</td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:center;color:" & typeColor & ";font-weight:bold;'>" & ttype & "</td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:right;'>" & FormatCurrency(face) & "</td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:right;'>" & FormatCurrency(principal) & "</td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:center;'>" & Format(rate * 100, "0.000") & "%</td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:center;color:#6b7280;'>" & Format(benchRate * 100, "0.000") & "%</td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:center;color:" & spreadColor & ";font-weight:bold;'>" & Format(spread, "+0.0;-0.0;0.0") & " bps</td><td style='padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:center;'>" & statusIcon & "</td></tr>"
