' ---------------------------------------------------------------
' DASHBOARD
' ---------------------------------------------------------------
Sub BuildDashboard()
    Dim wsSrc As Worksheet, wsDash As Worksheet, wsRates As Worksheet
    Dim lastRow As Long, i As Long, dataArr As Variant
    
    If Not SheetExists(SRC_SHEET) Then Exit Sub
    
    Set wsSrc = ThisWorkbook.Sheets(SRC_SHEET)
    Set wsRates = ThisWorkbook.Sheets(RATES_SHEET)
    
    On Error Resume Next
    ThisWorkbook.Sheets(DASH_SHEET).Delete
    On Error GoTo 0
    Set wsDash = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    wsDash.Name = DASH_SHEET
    
    wsDash.Cells.Interior.Color = RGB(15, 23, 42)
    wsDash.Cells.Font.Color = RGB(226, 232, 240)
    
    With wsDash.Range("A1:L1")
        .Merge
        .Value = "REPO / REVERSE REPO — TRADE ANALYTICS DASHBOARD"
        .Font.Size = 16
        .Font.Bold = True
        .Font.Color = RGB(96, 165, 250)
        .HorizontalAlignment = xlCenter
        .Interior.Color = RGB(15, 23, 42)
    End With
    
    wsDash.Range("A2").Value = "Last Refreshed: " & Format(Now, "dd-mmm-yyyy hh:mm AM/PM")
    wsDash.Range("A2").Font.Color = RGB(100, 116, 139)
    wsDash.Range("A2").Font.Italic = True
    
    lastRow = wsSrc.Cells(wsSrc.Rows.Count, 1).End(xlUp).Row
    If lastRow < 2 Then Exit Sub
    
    dataArr = wsSrc.Range(wsSrc.Cells(2, 1), wsSrc.Cells(lastRow, COL_RATE)).Value
    
    Dim totalFaceLong As Double, totalFaceShort As Double
    Dim totalPrincipal As Double, weightedRateSum As Double, rateCount As Long
    
    For i = 1 To UBound(dataArr, 1)
        Dim tranType As String, face As Double, rate As Double
        tranType = UCase(Trim(CStr(dataArr(i, COL_TRANTYPE))))
        face = 0: rate = 0
        On Error Resume Next
        face = CDbl(dataArr(i, COL_FACE))
        rate = CDbl(dataArr(i, COL_RATE))
        On Error GoTo 0
        
        If tranType = "REPO" Then
            totalFaceLong = totalFaceLong + face
        ElseIf tranType = "RR" Or InStr(tranType, "REVERSE") > 0 Then
            totalFaceShort = totalFaceShort + face
        End If
        
        If rate <> 0 Then
            weightedRateSum = weightedRateSum + rate
            rateCount = rateCount + 1
        End If
    Next i
    
    Dim avgRate As Double, sofrRate As Double, spreadBps As Double
    If rateCount > 0 Then avgRate = weightedRateSum / rateCount
    sofrRate = GetBenchmarkRate("SOFR", wsRates)
    If sofrRate <> 0 Then spreadBps = (avgRate - sofrRate) * 10000
    
    ' Hidden anchors for Control Panel
    wsDash.Range("B5").Value = totalFaceLong
    wsDash.Range("B6").Value = totalFaceShort
    wsDash.Range("B7").Value = totalFaceLong - totalFaceShort
    wsDash.Range("B8").Value = avgRate
    wsDash.Range("B8").NumberFormat = "0.000%"
    
    Call DrawDashKPI(wsDash, 4, 1, "TOTAL REPO FACE", totalFaceLong, RGB(30, 64, 175), "#,##0,,""M""")
    Call DrawDashKPI(wsDash, 4, 4, "TOTAL REV REPO FACE", totalFaceShort, RGB(127, 29, 29), "#,##0,,""M""")
    Call DrawDashKPI(wsDash, 4, 7, "NET POSITION", totalFaceLong - totalFaceShort, RGB(6, 78, 59), "#,##0,,""M""")
    Call DrawDashKPI(wsDash, 4, 10, "AVG RATE vs SOFR", spreadBps, RGB(92, 45, 145), "+0.0"" bps""")
    
    Call BuildSummaryTable(wsDash, wsSrc, lastRow, dataArr, wsRates)
    Call BuildSpreadHeatmap(wsDash, dataArr, wsRates)
    
    wsDash.Columns("A:M").AutoFit
    wsDash.Rows("1:40").RowHeight = 18
    wsDash.Tab.Color = RGB(99, 102, 241)
End Sub

Sub BuildSummaryTable(wsDash As Worksheet, wsSrc As Worksheet, lastRow As Long, dataArr As Variant, wsRates As Worksheet)
    Dim tableStartRow As Integer: tableStartRow = 8
    wsDash.Range("A" & tableStartRow).Value = "TRADE SUMMARY — By Counterparty > Category > Transaction Type"
    wsDash.Range("A" & tableStartRow).Font.Bold = True
    wsDash.Range("A" & tableStartRow).Font.Color = RGB(52, 211, 153)
    
    Dim hdrRow As Integer: hdrRow = tableStartRow + 1
    Dim headers As Variant
    headers = Array("Counterparty", "Category", "Tran Type", "Total Face", "Total Principal", "Avg Rate", "Benchmark Rate", "Spread (bps)", "Status")
    
    Dim h As Integer
    For h = 0 To UBound(headers)
        With wsDash.Cells(hdrRow, h + 1)
            .Value = headers(h)
            .Font.Bold = True
            .Font.Color = RGB(255, 255, 255)
            .Interior.Color = RGB(0, 51, 102)
            .HorizontalAlignment = xlCenter
        End With
    Next h
    
    ' Dictionary aggregation logic
    Dim keys() As String, faceArr() As Double, principalArr() As Double, rateSum() As Double, rateCount() As Long
    Dim keyCount As Long: keyCount = 0
    ReDim keys(0), faceArr(0), principalArr(0), rateSum(0), rateCount(0)
    
    Dim i As Long
    For i = 1 To UBound(dataArr, 1)
        Dim cpty As String, cat As String, ttype As String, face As Double, principal As Double, rate As Double
        cpty = Trim(CStr(dataArr(i, COL_CPTY)))
        cat = Trim(CStr(dataArr(i, COL_CATEGORY)))
        ttype = Trim(CStr(dataArr(i, COL_TRANTYPE)))
        face = 0: principal = 0: rate = 0
        On Error Resume Next
        face = CDbl(dataArr(i, COL_FACE))
        principal = CDbl(dataArr(i, COL_PRINCIPAL))
        rate = CDbl(dataArr(i, COL_RATE))
        On Error GoTo 0
        
        If face = 0 Then GoTo NextTrade
        Dim key As String: key = cpty & "|" & cat & "|" & ttype
        Dim found As Boolean: found = False
        Dim j As Long
        For j = 0 To keyCount - 1
            If keys(j) = key Then
                faceArr(j) = faceArr(j) + face
                principalArr(j) = principalArr(j) + principal
                rateSum(j) = rateSum(j) + rate
                rateCount(j) = rateCount(j) + 1
                found = True
                Exit For
            End If
        Next j
        If Not found Then
            ReDim Preserve keys(keyCount), faceArr(keyCount), principalArr(keyCount), rateSum(keyCount), rateCount(keyCount)
            keys(keyCount) = key
            faceArr(keyCount) = face
            principalArr(keyCount) = principal
            rateSum(keyCount) = rate
            rateCount(keyCount) = 1
            keyCount = keyCount + 1
        End If
NextTrade:
    Next i
    
    ' Sort
    Dim sorted As Boolean, temp As String, tempD As Double, tempL As Long
    Do
        sorted = True
        For i = 0 To keyCount - 2
            If keys(i) > keys(i + 1) Then
                temp = keys(i): keys(i) = keys(i + 1): keys(i + 1) = temp
                tempD = faceArr(i): faceArr(i) = faceArr(i + 1): faceArr(i + 1) = tempD
                tempD = principalArr(i): principalArr(i) = principalArr(i + 1): principalArr(i + 1) = tempD
                tempD = rateSum(i): rateSum(i) = rateSum(i + 1): rateSum(i + 1) = tempD
                tempL = rateCount(i): rateCount(i) = rateCount(i + 1): rateCount(i + 1) = tempL
                sorted = False
            End If
        Next i
    Loop Until sorted
    
    Dim dataRow As Integer: dataRow = hdrRow + 1
    Dim prevCpty As String, prevCat As String: prevCpty = "": prevCat = ""
    Dim cptyFace As Double, cptyPrincipal As Double: cptyFace = 0: cptyPrincipal = 0
    
    For i = 0 To keyCount - 1
        Dim parts() As String: parts = Split(keys(i), "|")
        Dim thisCpty As String, thisCat As String, thisTtype As String
        thisCpty = parts(0): thisCat = parts(1): thisTtype = parts(2)
        
        Dim avgRateVal As Double, benchRate As Double, spread As Double
        If rateCount(i) > 0 Then avgRateVal = rateSum(i) / rateCount(i)
        benchRate = GetBenchmarkForAsset(thisCat, thisTtype, wsRates)
        If benchRate <> 0 Then spread = (avgRateVal - benchRate) * 10000
        
        If thisCpty <> prevCpty And prevCpty <> "" Then
            wsDash.Rows(dataRow).Interior.Color = RGB(30, 41, 59)
            wsDash.Rows(dataRow).Font.Bold = True
            wsDash.Rows(dataRow).Font.Color = RGB(251, 191, 36)
            wsDash.Cells(dataRow, 1).Value = prevCpty & " Total"
            wsDash.Cells(dataRow, 4).Value = cptyFace
            wsDash.Cells(dataRow, 5).Value = cptyPrincipal
            wsDash.Range(wsDash.Cells(dataRow, 4), wsDash.Cells(dataRow, 5)).NumberFormat = "#,##0"
            dataRow = dataRow + 1
            cptyFace = 0: cptyPrincipal = 0
        End If
        
        Dim cptyDisplay As String, catDisplay As String
        If thisCpty = prevCpty Then cptyDisplay = "" Else cptyDisplay = thisCpty
        If thisCat = prevCat And thisCpty = prevCpty Then catDisplay = "" Else catDisplay = "  " & thisCat
        
        wsDash.Rows(dataRow).Interior.Color = IIf(i Mod 2 = 0, RGB(22, 33, 62), RGB(15, 23, 42))
        
        wsDash.Cells(dataRow, 1).Value = cptyDisplay
        wsDash.Cells(dataRow, 2).Value = catDisplay
        wsDash.Cells(dataRow, 3).Value = "    " & thisTtype
        wsDash.Cells(dataRow, 4).Value = faceArr(i)
        wsDash.Cells(dataRow, 5).Value = principalArr(i)
        wsDash.Range(wsDash.Cells(dataRow, 4), wsDash.Cells(dataRow, 5)).NumberFormat = "#,##0"
        
        wsDash.Cells(dataRow, 6).Value = avgRateVal
        wsDash.Cells(dataRow, 7).Value = benchRate
        wsDash.Range(wsDash.Cells(dataRow, 6), wsDash.Cells(dataRow, 7)).NumberFormat = "0.000%"
        
        wsDash.Cells(dataRow, 8).Value = spread
        wsDash.Cells(dataRow, 8).NumberFormat = "+0.0;-0.0;0.0"
        
        Dim status As String
        If benchRate = 0 Then
            status = "⚪ N/A"
            wsDash.Cells(dataRow, 9).Font.Color = RGB(100, 116, 139)
        ElseIf spread >= 5 Then
            status = "🟢 Inside"
            wsDash.Cells(dataRow, 9).Font.Color = RGB(52, 211, 153)
        ElseIf spread >= -5 Then
            status = "🟡 At Market"
            wsDash.Cells(dataRow, 9).Font.Color = RGB(251, 191, 36)
        Else
            status = "🔴 Outside"
            wsDash.Cells(dataRow, 9).Font.Color = RGB(248, 113, 113)
        End If
        wsDash.Cells(dataRow, 9).Value = status
        wsDash.Cells(dataRow, 9).Font.Bold = True
        
        If spread > 0 Then wsDash.Cells(dataRow, 8).Font.Color = RGB(52, 211, 153) Else If spread < 0 Then wsDash.Cells(dataRow, 8).Font.Color = RGB(248, 113, 113)
        
        cptyFace = cptyFace + faceArr(i)
        cptyPrincipal = cptyPrincipal + principalArr(i)
        prevCpty = thisCpty
        prevCat = thisCat
        dataRow = dataRow + 1
    Next i
    
    If prevCpty <> "" Then
        wsDash.Rows(dataRow).Interior.Color = RGB(30, 41, 59)
        wsDash.Rows(dataRow).Font.Bold = True
        wsDash.Rows(dataRow).Font.Color = RGB(251, 191, 36)
        wsDash.Cells(dataRow, 1).Value = prevCpty & " Total"
        wsDash.Cells(dataRow, 4).Value = cptyFace
        wsDash.Cells(dataRow, 5).Value = cptyPrincipal
        wsDash.Range(wsDash.Cells(dataRow, 4), wsDash.Cells(dataRow, 5)).NumberFormat = "#,##0"
        dataRow = dataRow + 1
    End If
    
    wsDash.Rows(dataRow).Interior.Color = RGB(0, 51, 102)
    wsDash.Rows(dataRow).Font.Bold = True
    wsDash.Rows(dataRow).Font.Color = RGB(255, 255, 255)
    wsDash.Cells(dataRow, 1).Value = "GRAND TOTAL"
    wsDash.Cells(dataRow, 4).Formula = "=SUM(" & wsDash.Cells(hdrRow + 1, 4).Address & ":" & wsDash.Cells(dataRow - 1, 4).Address & ")"
    wsDash.Cells(dataRow, 5).Formula = "=SUM(" & wsDash.Cells(hdrRow + 1, 5).Address & ":" & wsDash.Cells(dataRow - 1, 5).Address & ")"
    wsDash.Range(wsDash.Cells(dataRow, 4), wsDash.Cells(dataRow, 5)).NumberFormat = "#,##0"
End Sub

Sub BuildSpreadHeatmap(wsDash As Worksheet, dataArr As Variant, wsRates As Worksheet)
    Dim hmStartRow As Integer: hmStartRow = 45
    wsDash.Cells(hmStartRow, 1).Value = "SPREAD HEATMAP — Avg Spread to Benchmark (bps) by Counterparty & Asset"
    wsDash.Cells(hmStartRow, 1).Font.Bold = True
    wsDash.Cells(hmStartRow, 1).Font.Color = RGB(251, 191, 36)
    
    Dim cptys(10) As String, cats(10) As String
    Dim cptyCount As Integer: cptyCount = 0
    Dim catCount As Integer: catCount = 0
    
    Dim i As Long
    For i = 1 To UBound(dataArr, 1)
        Dim thisCpty As String: thisCpty = Trim(CStr(dataArr(i, COL_CPTY)))
        Dim thisCat As String: thisCat = Trim(CStr(dataArr(i, COL_CATEGORY)))
        
        If thisCpty <> "" And Not InStringArray(cptys, thisCpty, cptyCount) Then
            cptys(cptyCount) = thisCpty
            cptyCount = cptyCount + 1
        End If
        If thisCat <> "" And Not InStringArray(cats, thisCat, catCount) Then
            cats(catCount) = thisCat
            catCount = catCount + 1
        End If
    Next i
    
    If cptyCount = 0 Or catCount = 0 Then Exit Sub
    
    Dim hdrRow As Integer: hdrRow = hmStartRow + 1
    wsDash.Cells(hdrRow, 1).Value = "Cpty \ Asset"
    wsDash.Cells(hdrRow, 1).Font.Bold = True
    wsDash.Cells(hdrRow, 1).Interior.Color = RGB(0, 51, 102)
    
    Dim c As Integer
    For c = 0 To catCount - 1
        wsDash.Cells(hdrRow, c + 2).Value = cats(c)
        wsDash.Cells(hdrRow, c + 2).Font.Bold = True
        wsDash.Cells(hdrRow, c + 2).Interior.Color = RGB(0, 51, 102)
        wsDash.Cells(hdrRow, c + 2).HorizontalAlignment = xlCenter
    Next c
    
    Dim r As Integer
    For r = 0 To cptyCount - 1
        wsDash.Cells(hdrRow + 1 + r, 1).Value = cptys(r)
        wsDash.Cells(hdrRow + 1 + r, 1).Font.Bold = True
        
        For c = 0 To catCount - 1
            Dim totalRate As Double, totalBench As Double, cnt As Long
            totalRate = 0: totalBench = 0: cnt = 0
            
            For i = 1 To UBound(dataArr, 1)
                If Trim(CStr(dataArr(i, COL_CPTY))) = cptys(r) And Trim(CStr(dataArr(i, COL_CATEGORY))) = cats(c) Then
                    Dim face As Double: face = 0
                    Dim rate As Double: rate = 0
                    On Error Resume Next
                    face = CDbl(dataArr(i, COL_FACE))
                    rate = CDbl(dataArr(i, COL_RATE))
                    On Error GoTo 0
                    If face <> 0 Then
                        Dim bench As Double
                        bench = GetBenchmarkForAsset(cats(c), CStr(dataArr(i, COL_TRANTYPE)), wsRates)
                        totalRate = totalRate + rate
                        totalBench = totalBench + bench
                        cnt = cnt + 1
                    End If
                End If
            Next i
            
            Dim cellRef As Range: Set cellRef = wsDash.Cells(hdrRow + 1 + r, c + 2)
            If cnt > 0 Then
                Dim spreadVal As Double
                spreadVal = ((totalRate / cnt) - (totalBench / cnt)) * 10000
                cellRef.Value = spreadVal
                cellRef.NumberFormat = "+0.0;-0.0;""—"""
                Dim intensity As Integer
                intensity = WorksheetFunction.Min(200, WorksheetFunction.Max(0, CInt(Abs(spreadVal) * 10)))
                If spreadVal > 0 Then
                    cellRef.Interior.Color = RGB(0, intensity, 0)
                    cellRef.Font.Color = RGB(200, 255, 200)
                ElseIf spreadVal < 0 Then
                    cellRef.Interior.Color = RGB(intensity, 0, 0)
                    cellRef.Font.Color = RGB(255, 200, 200)
                Else
                    cellRef.Interior.Color = RGB(40, 40, 40)
                End If
