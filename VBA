Sub AddButton(ws As Worksheet, caption As String, macroName As String, rowNum As Integer, colNum As Integer, colSpan As Integer, btnColor As Long)
    Dim btn As Shape
    Dim topPos As Double, leftPos As Double, btnWidth As Double, btnHeight As Double
    topPos = ws.Rows(rowNum).Top + 3
    leftPos = ws.Columns(colNum).Left + 3
    btnWidth = 0
    Dim c As Integer
    For c = colNum To colNum + colSpan - 1
        btnWidth = btnWidth + ws.Columns(c).Width
    Next c
    btnHeight = ws.Rows(rowNum).Height * 1.5 - 6
    Set btn = ws.Shapes.AddShape(msoShapeRoundedRectangle, leftPos, topPos, btnWidth - 6, btnHeight)
    With btn
        .Fill.ForeColor.RGB = btnColor
        .Line.ForeColor.RGB = RGB(255, 255, 255)
        .Line.Weight = 1
        With .TextFrame2.TextRange
            .Text = caption
            .Font.Bold = True
            .Font.Size = 10
            .Font.Fill.ForeColor.RGB = RGB(255, 255, 255)
        End With
        .TextFrame.HorizontalAlignment = xlHAlignCenter
        .TextFrame.VerticalAlignment = xlVAlignCenter
        .OnAction = macroName
    End With
End Sub

Function GetBenchmarkRate(rateName As String, wsRates As Worksheet) As Double
    Dim i As Integer
    For i = 2 To 11
        If Trim(wsRates.Cells(i, 1).Value) = rateName Then
            GetBenchmarkRate = CDbl(wsRates.Cells(i, 3).Value)
            Exit Function
        End If
    Next i
    GetBenchmarkRate = 0
End Function

Function GetBenchmarkForAsset(category As String, tranType As String, wsRates As Worksheet) As Double
    Dim cat As String: cat = UCase(category)
    If InStr(cat, "US") > 0 Or InStr(cat, "UST") > 0 Or InStr(cat, "TREASURY") > 0 Then
        GetBenchmarkForAsset = GetBenchmarkRate("CME UST Repo", wsRates)
    ElseIf InStr(cat, "GILT") > 0 Or InStr(cat, "UK") > 0 Then
        GetBenchmarkForAsset = GetBenchmarkRate("CME Gilt Repo", wsRates)
    ElseIf InStr(cat, "AGENCY") > 0 Then
        GetBenchmarkForAsset = GetBenchmarkRate("SOFR+3", wsRates)
    Else
        GetBenchmarkForAsset = GetBenchmarkRate("SOFR", wsRates)
    End If
End Function

Function InStringArray(arr() As String, val As String, count As Integer) As Boolean
