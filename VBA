Function FormatCurrency(amount As Double) As String
    If Abs(amount) >= 1000000000 Then
        FormatCurrency = Format(amount / 1000000000, "0.0") & "B"
    ElseIf Abs(amount) >= 1000000 Then
        FormatCurrency = Format(amount / 1000000, "0.0") & "M"
    ElseIf Abs(amount) >= 1000 Then
        FormatCurrency = Format(amount / 1000, "0.0") & "K"
    Else
        FormatCurrency = Format(amount, "#,##0")
    End If
End Function
