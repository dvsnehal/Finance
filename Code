        col_dim = st.selectbox("Column Dimension", ["tran_type","final_bucket","bond_ccy","type"], index=0)
    with pcol3:
        metric = st.selectbox("Metric", ["principal","face","rate"], index=0)

    pivot_df = df.groupby([row_dim, col_dim])[metric].agg(
        "mean" if metric=="rate" else "sum"
    ).unstack(fill_value=0)
    if metric != "rate":
        display_pivot = pivot_df.map(fmt_millions)
    else:
        display_pivot = pivot_df.map(fmt_rate)
    st.dataframe(display_pivot, use_container_width=True, height=500)

    st.markdown(\'\'\'
    <div class="section-header" style="margin-top:2rem">
        <div class="dot" style="background:var(--accent-purple)"></div>
        <h3>Net Exposure by Currency (R − RR)</h3>
    </div>\'\'\', unsafe_allow_html=True)
    net_df = df.groupby(["bond_ccy","tran_type"])["principal"].sum().unstack(fill_value=0)
    if "R"  in net_df.columns and "RR" in net_df.columns: net_df["Net (R-RR)"] = net_df["R"] - net_df["RR"]
    elif "R"  in net_df.columns: net_df["Net (R-RR)"] = net_df["R"]
    elif "RR" in net_df.columns: net_df["Net (R-RR)"] = -net_df["RR"]
    st.dataframe(net_df.map(fmt_millions), use_container_width=True)

# ── TAB 3: RAW TRADES ──
with tab3:
    st.markdown(\'\'\'
    <div class="section-header">
        <div class="dot" style="background:var(--accent-teal)"></div>
        <h3>Raw Trade Level Data</h3>
    </div>\'\'\', unsafe_allow_html=True)
    rcol1, rcol2, rcol3 = st.columns([3,3,2])
    with rcol1:
        search = st.text_input("🔍 Search counterparty", "", placeholder="Type to filter...")
    with rcol2:
        sort_col = st.selectbox("Sort by", ["principal","face","rate","cpty","bond_ccy"], index=0)
    with rcol3:
        sort_asc = st.checkbox("Ascending", value=False)

    view_df = df.copy()
    if search: view_df = view_df[view_df["cpty"].str.contains(search, case=False, na=False)]
    view_df = view_df.sort_values(sort_col, ascending=sort_asc)
    view_df["rate"]      = view_df["rate"].apply(lambda x: f"{x:.4f}%")
    view_df["principal"] = view_df["principal"].apply(fmt_millions)
    view_df["face"]      = view_df["face"].apply(fmt_millions)
    show_cols = [c for c in ["cpty","bond_ccy","tran_type","final_bucket","structure",
                              "principal","face","rate","type","is_emerging_market"] if c in view_df.columns]
    st.dataframe(view_df[show_cols].reset_index(drop=True), use_container_width=True, height=600)
    st.markdown(f\'<div style="font-family:var(--font-mono);font-size:0.7rem;color:var(--text-muted);text-align:right;">{len(view_df):,} trades shown</div>\', unsafe_allow_html=True)
'''

