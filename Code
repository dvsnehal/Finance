BUCKET_ORDER = ["0-1D","1-2D","2-7D","8-30D","31-90D","91-180D","181-365D","1-2Y","2-5Y","5Y+","No Bucket"]

def fmt_millions(val):
    if pd.isna(val) or val == 0: return "—"
    abs_val = abs(val)
    if abs_val >= 1e9:  return f"{val/1e9:.2f}B"
    if abs_val >= 1e6:  return f"{val/1e6:.1f}M"
    if abs_val >= 1e3:  return f"{val/1e3:.0f}K"
    return f"{val:,.0f}"

def fmt_rate(val):
    if pd.isna(val): return "—"
    return f"{val:.4f}%"

def sort_buckets(df, col="final_bucket"):
    cat = pd.Categorical(df[col], categories=BUCKET_ORDER, ordered=True)
    df = df.copy()
    df[col] = cat
    return df.sort_values(col)

@st.cache_data(show_spinner=False)
def load_data(file_bytes):
    df = pd.read_excel(BytesIO(file_bytes), sheet_name="Trade Data")
    str_cols = df.select_dtypes(include="object").columns
    for c in str_cols:
        df[c] = df[c].astype(str).str.strip()
    for c in str_cols:
        df[c] = df[c].replace({"nan":"","None":"","NaN":""})
    df["final_bucket"] = df["final_bucket"].replace("","No Bucket").fillna("No Bucket")
    for col in ["principal","face","rate"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce").fillna(0)
    return df

def apply_filters(df, sel_type, sel_em, sel_cpty, sel_ccy, sel_bucket, sel_tran):
    d = df.copy()
    if sel_type:   d = d[d["type"].isin(sel_type)]
    if sel_em:     d = d[d["is_emerging_market"].isin(sel_em)]
    if sel_cpty:   d = d[d["cpty"].isin(sel_cpty)]
    if sel_ccy:    d = d[d["bond_ccy"].isin(sel_ccy)]
    if sel_bucket: d = d[d["final_bucket"].isin(sel_bucket)]
    if sel_tran:   d = d[d["tran_type"].isin(sel_tran)]
    return d

def agg(df):
    return {
        "principal": df["principal"].sum(),
        "face":      df["face"].sum(),
        "rate":      df["rate"].mean() if len(df) else np.nan,
        "count":     len(df),
    }

def to_excel_export(df):
    buf = BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Filtered Trades")
    return buf.getvalue()

