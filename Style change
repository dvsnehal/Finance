        ws.freeze_panes = ws.cell(row=start_row + 1, column=1)

    return buf.getvalue()


def fmt_num(val, suffix=""):
    if pd.isna(val) or val == 0:
        return "—"
    try:
        val = float(val)
        formatted = f"{abs(val):,.0f}"
        return f'<span style="color:red">-{formatted}{suffix}</span>' if val < 0 else f"{formatted}{suffix}"
    except Exception:
        return str(val)


def fmt_pct(val):
    if pd.isna(val):
        return "—"
    try:
        return f"{float(val)*100:.2f}%"
    except Exception:
        return str(val)


