def get_display_values(df_subset, use_usd):
    currencies = df_subset["bond_ccy"].nunique()
    if use_usd:
        if "principal_usd" not in df_subset.columns or "face_usd" not in df_subset.columns:
            return df_subset["principal"].sum(), df_subset["face"].sum(), "RAW"
        return df_subset["principal_usd"].sum(), df_subset["face_usd"].sum(), "USD"
    if currencies == 1:
        ccy = df_subset["bond_ccy"].dropna().iloc[0]
        return df_subset["principal"].sum(), df_subset["face"].sum(), ccy
    else:
        if "principal_usd" not in df_subset.columns or "face_usd" not in df_subset.columns:
            return df_subset["principal"].sum(), df_subset["face"].sum(), "RAW"
        return df_subset["principal_usd"].sum(), df_subset["face_usd"].sum(), "USD"


def fmt_millions(val, suffix=""):
    if pd.isna(val) or val == 0:
        return "—"
    abs_val = abs(val)
    if abs_val >= 1e9:
        return f"{val/1e9:.2f}B{suffix}"
    if abs_val >= 1e6:
        return f"{val/1e6:.1f}M{suffix}"
    if abs_val >= 1e3:
        return f"{val/1e3:.0f}K{suffix}"
    return f"{val:.0f}{suffix}"


def fmt_rate(val):
    if pd.isna(val):
        return "—"
    return f"{val*100:.4f}%"


def get_benchmark_name_for_ccy(ccy):
    ccy = str(ccy).upper().strip()
    if ccy == "EUR":
        return "ESTR"
    elif ccy == "GBP":
        return "SONIA"
    elif ccy == "USD":
        return st.session_state.get("benchmark_name", "Term SOFR")
    else:
        return "Benchmark"


def get_benchmark_rate_for_ccy(ccy):
    ccy = str(ccy).upper().strip()
    benchmarks = st.session_state.get("benchmarks", {
        "Term SOFR": 0.0538,
        "SOFR": 0.0538,
        "ESTR": 0.0390,
        "SONIA": 0.0528,
    })
    if ccy == "EUR":
        return benchmarks.get("ESTR", np.nan)
    if ccy == "GBP":
        return benchmarks.get("SONIA", np.nan)
    if ccy == "USD":
        active_usd_benchmark = st.session_state.get("benchmark_name", "Term SOFR")
        return benchmarks.get(active_usd_benchmark, np.nan)
    return np.nan


def fmt_spread(rate, benchmark_rate):
    if pd.isna(rate) or pd.isna(benchmark_rate):
        return "—"
    return f"{(rate - benchmark_rate) * 10000:.0f} bps"


def weighted_avg_rate(df_subset):
    if df_subset.empty:
        return np.nan
    if df_subset["bond_ccy"].nunique() == 1:
        weights = df_subset["principal"].abs()
    else:
        weights = df_subset["principal_usd"].abs()
    rates = df_subset["rate"]
    valid = weights > 0
    if not valid.any():
        return np.nan
    return (rates[valid] * weights[valid]).sum() / weights[valid].sum()


@st.cache_data(show_spinner=False)
def load_data(file_bytes, fx_override=None):
    try:
        df = pd.read_excel(BytesIO(file_bytes), sheet_name="Trade Data")
    except Exception:
        df = pd.read_excel(BytesIO(file_bytes))

    df.columns = df.columns.str.strip().str.lower().str.replace(" ", "_")

    required_cols = ["type", "cpty", "principal", "face", "rate", "tran_type"]
    missing = [c for c in required_cols if c not in df.columns]
    if missing:
        st.error(f"Missing required columns: {missing}")
        st.stop()

    str_cols = df.select_dtypes(include=["object"]).columns
    for c in str_cols:
        df[c] = df[c].astype(str).str.strip()
        df[c] = df[c].replace("nan", np.nan).replace("", np.nan)

    if "bond_ccy" in df.columns:
        df["bond_ccy"] = df["bond_ccy"].str.upper()

    if "final_bucket" in df.columns:
        df["final_bucket"] = df["final_bucket"].fillna("No Bucket").astype(str).str.strip()
        df["final_bucket"] = df["final_bucket"].replace("nan", "No Bucket")

    if "structure" in df.columns:
        df["structure"] = df["structure"].fillna("Unknown")

    # Rate normalisation
    if df["rate"].median() > 20:
        df["rate"] = df["rate"] / 100

    FX = {
        "USD": 1.0,
        "EUR": 1.08,
        "GBP": 1.25,
        "JPY": 0.0068,
        "CHF": 1.10,
        "ZAR": 0.055,
        "CAD": 0.74,
        "AUD": 0.66,
    }
    if fx_override is not None:
        FX.update(fx_override)

    df["fx_rate"] = df["bond_ccy"].map(FX).fillna(1)
    df["principal_usd"] = df["principal"] * df["fx_rate"]
    df["face_usd"] = df["face"] * df["fx_rate"]

    df = df[df["cpty"].notna()]
    df = df[df["cpty"].str.strip() != ""]
    df = df[(df["principal"] != 0) & (df["face"] != 0)]
    df = df.drop_duplicates()

    if df.empty:
        st.error("No valid trades after cleaning.")
        st.stop()
    return df


def apply_filters(df, sel_flag, sel_type, sel_em, sel_cpty, sel_ccy,
                  sel_bucket, sel_tran, sel_book, sel_struct):
    d = df.copy()
    if sel_flag and "flag" in d.columns:
        d = d[d["flag"].isin(sel_flag)]
    if sel_type:
        d = d[d["type"].isin(sel_type)]
    if sel_em and "is_emerging_market" in d.columns:
        d = d[d["is_emerging_market"].isin(sel_em)]
    if sel_cpty:
        d = d[d["cpty"].isin(sel_cpty)]
    if sel_ccy:
        d = d[d["bond_ccy"].isin(sel_ccy)]
    if sel_bucket and "final_bucket" in d.columns:
        d = d[d["final_bucket"].isin(sel_bucket)]
    if sel_tran:
        d = d[d["tran_type"].isin(sel_tran)]
    if sel_book and "book" in d.columns:
        d = d[d["book"].isin(sel_book)]
    if sel_struct and "structure" in d.columns:
        d = d[d["structure"].isin(sel_struct)]
    return d


def agg(df):
    return {
        "principal": df["principal"].sum(),
        "face": df["face"].sum(),
        "rate": weighted_avg_rate(df),
        "count": len(df),
    }


def _ordered_unique(series):
    return [x for x in series.dropna().tolist() if str(x).strip()]


def build_hierarchy_export_df(df, use_usd=True):
    rows = []

    def get_vals(d):
        if use_usd:
            return d["face_usd"].sum(), d["principal_usd"].sum(), "USD"
        if d["bond_ccy"].nunique() == 1:
            ccy = d["bond_ccy"].dropna().iloc[0]
            return d["face"].sum(), d["principal"].sum(), ccy
        return d["face_usd"].sum(), d["principal_usd"].sum(), "USD"

    type_order = list(dict.fromkeys(df["type"].dropna().tolist()))
    for typ in type_order:
        type_df = df[df["type"] == typ]
        rows.append({
            "Total in Core": str(typ),
            "Face": None,
            "Principal": None,
            "FIF/COU repo rate": None,
            "level": 0,
            "row_type": "type",
        })
        spty_order = list(dict.fromkeys(type_df["cpty"].dropna().tolist()))
        first_cpty = True
        for cpty in spty_order:
            cpty_df = type_df[type_df["cpty"] == cpty]
            if not first_cpty:
                rows.append({
                    "Total in Core": "",
                    "Face": None,
                    "Principal": None,
                    "FIF/COU repo rate": None,
                    "level": 1,
                    "row_type": "spacer",
                })
            first_cpty = False
            cpty_face, cpty_principal, cpty_label = get_vals(cpty_df)
            rows.append({
                "Total in Core": str(cpty),
                "Face": cpty_face,
                "Principal": cpty_principal,
                "FIF/COU repo rate": cpty_df["rate"].mean() if len(cpty_df) else None,
                "level": 1,
                "row_type": "cpty",
            })
            ccy_order = list(dict.fromkeys(cpty_df["bond_ccy"].dropna().tolist()))
            for ccy in ccy_order:
                ccy_df = cpty_df[cpty_df["bond_ccy"] == ccy]
                ccy_face, ccy_principal, ccy_label = get_vals(ccy_df)
                rows.append({
                    "Total in Core": f"{ccy} ({ccy_label})",
                    "Face": ccy_face,
                    "Principal": ccy_principal,
                    "FIF/COU repo rate": None,
                    "level": 2,
                    "row_type": "ccy",
                })
                bucket_order = list(dict.fromkeys(
                    ccy_df["final_bucket"].fillna("No Bucket").tolist()
                ))
                for bucket in bucket_order:
                    bkt_df = ccy_df[ccy_df["final_bucket"].fillna("No Bucket") == bucket]
                    bkt_face, bkt_principal, bkt_label = get_vals(bkt_df)
                    rows.append({
                        "Total in Core": str(bucket),
                        "Face": bkt_face,
                        "Principal": bkt_principal,
                        "FIF/COU repo rate": bkt_df["rate"].mean() if len(bkt_df) else None,
                        "level": 3,
                        "row_type": "bucket",
                    })
                    struct_order = list(dict.fromkeys(
                        bkt_df["structure"].fillna("Unknown").tolist()
                    ))
                    for struct in struct_order:
                        s_df = bkt_df[bkt_df["structure"].fillna("Unknown") == struct]
                        s_face, s_principal, s_label = get_vals(s_df)
                        rows.append({
                            "Total in Core": str(struct),
                            "Face": s_face,
                            "Principal": s_principal,
                            "FIF/COU repo rate": s_df["rate"].mean() if len(s_df) else None,
                            "level": 4,
                            "row_type": "structure",
                        })
        rows.append({
            "Total in Core": "",
            "Face": None,
            "Principal": None,
            "FIF/COU repo rate": None,
            "level": 0,
            "row_type": "blank",
        })

    grand_face, grand_principal, grand_label = get_vals(df)
    rows.append({
        "Total in Core": f"Grand Total ({grand_label})",
        "Face": grand_face,
        "Principal": grand_principal,
        "FIF/COU repo rate": None,
        "level": 0,
        "row_type": "grand_total",
    })
    return pd.DataFrame(rows)


def to_excel_export(df):
    benchmark_name = st.session_state.get("benchmark_name", "Term SOFR")
    benchmark_rate = st.session_state.get("benchmark_rate", 0.0363)
    total_p, total_f, base_ccy = get_display_values(df, True)
    avg_repo_rate = weighted_avg_rate(df[df["tran_type"] == "R"]) if "R" in df["tran_type"].values else np.nan
    avg_rr_rate = weighted_avg_rate(df[df["tran_type"] == "RR"]) if "RR" in df["tran_type"].values else np.nan
    spread_benchmark = (avg_repo_rate - benchmark_rate) if not pd.isna(avg_repo_rate) else np.nan
    spreader_benchmark = (benchmark_rate - avg_rr_rate) if not pd.isna(avg_rr_rate) else np.nan
    n_cpty = df["cpty"].nunique()
    n_ccy = df["bond_ccy"].nunique()
    net_p = df[df["tran_type"] == "R"]["principal_usd"].sum() - df[df["tran_type"] == "RR"]["principal_usd"].sum() if "tran_type" in df.columns else 0
    rr_p = df[df["tran_type"] == "RR"]["principal_usd"].sum() if "tran_type" in df.columns else 0

    kpi_labels = [
        f"Total Principal ({base_ccy})",
        f"Total Face ({base_ccy})",
        "Net Exposure (USD)",
        "Reverse Repo (USD)",
        "Avg Repo Rate (R)",
        "Avg RR Rate",
        f"Repo vs {benchmark_name}",
        f"{benchmark_name} vs RR",
        "Trades",
        "Counterparties",
        "Currencies",
    ]
    kpi_values = [
        fmt_millions(total_p),
        fmt_millions(total_f),
        fmt_millions(net_p),
        fmt_millions(rr_p),
        fmt_rate(avg_repo_rate),
        fmt_rate(avg_rr_rate),
        f"{spread_benchmark*10000:.0f} bps" if not pd.isna(spread_benchmark) else "—",
        f"{spreader_benchmark*10000:.0f} bps" if not pd.isna(spreader_benchmark) else "—",
        f"{len(df):,}",
        f"{n_cpty}",
        f"{n_ccy}",
    ]

    export_df = build_hierarchy_export_df(df, True)
    buf = BytesIO()

    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        kpi_df = pd.DataFrame([kpi_labels, kpi_values])
        kpi_df.to_excel(writer, index=False, header=False, startrow=0,
                        sheet_name="Hierarchy Export")
        ws = writer.sheets["Hierarchy Export"]

        start_row = 4
        export_df.drop(columns=["level", "row_type"], errors="ignore").to_excel(
            writer, index=False, startrow=start_row - 1, sheet_name="Hierarchy Export"
        )

        NAVY = "00395D"
        CYAN_LIGHT = "E0F5FD"
        TOTAL_BLUE = "BDD7EE"
        WHITE = "FFFFFF"
        HEADER_BG = "00395D"

        header_fill = PatternFill(fill_type="solid", fgColor=HEADER_BG)
        total_fill = PatternFill(fill_type="solid", fgColor=TOTAL_BLUE)
        white_fill = PatternFill(fill_type="solid", fgColor=WHITE)
        cyan_light_fill = PatternFill(fill_type="solid", fgColor="CCE9F6")

        bold_font = Font(bold=True)
        cpty_font = Font(bold=True, size=11)
        type_font = Font(bold=True, size=12)
        normal_font = Font(bold=False)
        header_font = Font(bold=True, color="FFFFFF")

        thin_side = Side(style="thin", color="D4E3EE")
        medium_side = Side(style="medium", color="00395D")
        thin_border = Border(left=thin_side, right=thin_side,
                             top=thin_side, bottom=thin_side)
        medium_top_border = Border(left=thin_side, right=thin_side,
                                   top=medium_side, bottom=thin_side)
        section_border = Border(left=thin_side, right=thin_side,
                                top=medium_side, bottom=medium_side)

        # KPI header row
        for col_idx in range(1, len(kpi_labels) + 1):
            cell = ws.cell(row=1, column=col_idx)
            cell.fill = header_fill
            cell.font = header_font
            cell.border = thin_border
            cell.alignment = Alignment(horizontal="center")
        for col_idx in range(1, len(kpi_values) + 1):
            cell = ws.cell(row=2, column=col_idx)
            cell.alignment = Alignment(horizontal="center")
            cell.border = thin_border

        ws.column_dimensions["A"].width = 30
        ws.column_dimensions["B"].width = 18
        ws.column_dimensions["C"].width = 18
        ws.column_dimensions["D"].width = 16

        for i, row in export_df.iterrows():
            excel_row = start_row + i + 1
            level = int(row.get("level", 0)) if pd.notna(row.get("level")) else 0
            row_type = row.get("row_type", "")
            label_cell = ws.cell(excel_row, 1)
            face_cell = ws.cell(excel_row, 2)
            principal_cell = ws.cell(excel_row, 3)
            rate_cell = ws.cell(excel_row, 4)

            for c in range(1, 5):
                ws.cell(excel_row, c).fill = white_fill
                ws.cell(excel_row, c).border = thin_border

            label_cell.alignment = Alignment(horizontal="left", indent=level * 2)
            face_cell.alignment = Alignment(horizontal="right")
            principal_cell.alignment = Alignment(horizontal="right")
            rate_cell.alignment = Alignment(horizontal="right")
            face_cell.number_format = '#,##0'
            principal_cell.number_format = '#,##0'
            rate_cell.number_format = '0.00%'

            if row_type == "type":
                for c in range(1, 5):
                    ws.cell(excel_row, c).fill = cyan_light_fill
