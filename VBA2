Option Explicit

' ============================================================
' COMPLETE REPO DASHBOARD — SINGLE MODULE
' Instructions:
' 1. Delete ALL existing modules
' 2. Make sure Sheet1 (Trade Data) code window is EMPTY
' 3. Insert ONE new Module (Insert > Module)
' 4. Paste this entire file
' 5. Press Option+F8, select RunFullSetup, click Run
' ============================================================

' ---- CONSTANTS — adjust column numbers if needed ----
' Column A=1, B=2, C=3 etc.
Dim SRC_SHEET       As String
Dim DASH_SHEET      As String
Dim RATES_SHEET     As String
Dim CONTROL_SHEET   As String
Dim DRILLDOWN_SHEET As String
Dim COL_CPTY        As Integer
Dim COL_CATEGORY    As Integer
Dim COL_TRANTYPE    As Integer
Dim COL_FACE        As Integer
Dim COL_PRINCIPAL   As Integer
Dim COL_RATE        As Integer

Sub InitConstants()
    SRC_SHEET       = "Trade Data"
    DASH_SHEET      = "Dashboard"
    RATES_SHEET     = "Benchmark Rates"
    CONTROL_SHEET   = "Control Panel"
    DRILLDOWN_SHEET = "Trade Drill-Down"
    COL_CPTY        = 1
    COL_CATEGORY    = 2
    COL_TRANTYPE    = 3
    COL_FACE        = 4
    COL_PRINCIPAL   = 5
    COL_RATE        = 6
End Sub

' ============================================================
' MASTER SETUP — RUN THIS FIRST
' ============================================================
Sub RunFullSetup()
    Call InitConstants
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    Call BuildRatesSheet
    Call BuildControlPanel
    Call BuildDashboard
    Call BuildDrillDown

    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True

    MsgBox "Dashboard built successfully! Go to Control Panel sheet.", vbInformation, "Done"
End Sub

Sub RefreshDashboard()
    Call InitConstants
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    Call BuildDashboard
    Call BuildDrillDown

    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    MsgBox "Refreshed!", vbInformation, "Done"
End Sub

' ============================================================
' BENCHMARK RATES SHEET
' ============================================================
Sub BuildRatesSheet()
    Dim ws As Worksheet
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Sheets(RATES_SHEET).Delete
    Application.DisplayAlerts = True
    On Error GoTo 0

    Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    ws.Name = RATES_SHEET

    With ws.Range("A1:F1")
        .Value = Array("Rate Name", "Ticker", "Rate (%)", "Source", "Updated", "Notes")
        .Font.Bold = True
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(0, 51, 102)
        .HorizontalAlignment = xlCenter
    End With

    Dim r As Integer
    Dim data As Variant
    data = Array( _
        Array("SOFR",          "SOFR Index",     0.053,  "Bloomberg", "Manual", "Secured Overnight Financing Rate"), _
        Array("SOFR+3",        "SOFR Index",     0.0533, "Bloomberg", "Manual", "SOFR + 3bps"), _
        Array("SOFR+4",        "SOFR Index",     0.0534, "Bloomberg", "Manual", "SOFR + 4bps"), _
        Array("SOFR+10",       "SOFR Index",     0.054,  "Bloomberg", "Manual", "SOFR + 10bps"), _
        Array("Fed Funds",     "FEDL01 Index",   0.0533, "Bloomberg", "Manual", "Effective Fed Funds"), _
        Array("SONIA",         "SONIO/N Index",  0.052,  "Bloomberg", "Manual", "Sterling Overnight Index"), _
        Array("UST GC Rate",   "USGG10YR Index", 0.045,  "Bloomberg", "Manual", "UST General Collateral"), _
        Array("CME UST Repo",  "CMEUST Index",   0.0531, "Bloomberg", "Manual", "CME UST Repo Reference"), _
        Array("CME Gilt Repo", "CMEGILT Index",  0.0515, "Bloomberg", "Manual", "CME Gilt Repo Reference") _
    )

    For r = 0 To UBound(data)
        ws.Cells(r + 2, 1).Value = data(r)(0)
        ws.Cells(r + 2, 2).Value = data(r)(1)
        ws.Cells(r + 2, 3).Value = data(r)(2)
        ws.Cells(r + 2, 3).NumberFormat = "0.000%"
        ws.Cells(r + 2, 4).Value = data(r)(3)
        ws.Cells(r + 2, 5).Value = data(r)(4)
        ws.Cells(r + 2, 6).Value = data(r)(5)
    Next r

    ws.Range("A12").Value = "To use Bloomberg: replace Column C with =BDP(""SOFR Index"",""PX_LAST"")/100"
    ws.Range("A12").Font.Color = RGB(180, 0, 0)
    ws.Columns("A:F").AutoFit
    ws.Tab.Color = RGB(0, 112, 192)
End Sub

' ============================================================
' CONTROL PANEL SHEET
' ============================================================
