    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Sheets(CONTROL_SHEET).Delete
    Application.DisplayAlerts = True
    On Error GoTo 0

    Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(1))
    ws.Name = CONTROL_SHEET
    ws.Cells.Interior.Color = RGB(15, 23, 42)
    ws.Cells.Font.Color = RGB(226, 232, 240)

    With ws.Range("B2:L2")
        .Merge
        .Value = "REPO / REVERSE REPO TRADE ANALYTICS DASHBOARD"
        .Font.Size = 18
        .Font.Bold = True
        .Font.Color = RGB(96, 165, 250)
        .HorizontalAlignment = xlCenter
    End With

    With ws.Range("B3:L3")
        .Merge
        .Value = "Control Panel — Run Setup, Refresh Data, Send Email"
        .Font.Size = 11
        .Font.Color = RGB(148, 163, 184)
