.kpi-card.cyan   .kpi-value { color: #0090C8 !important; }
.kpi-card.teal   .kpi-value { color: #007A99 !important; }
.kpi-card.amber  .kpi-value { color: #B45309 !important; }
.kpi-card.green  .kpi-value { color: #047857 !important; }
.kpi-card.red    .kpi-value { color: #B91C1C !important; }
.kpi-card.purple .kpi-value { color: #6D28D9 !important; }

